# ===================================================================
#  finauto — lo que NUNCA sube al repo
# ===================================================================

# Credenciales de bancos (DPAPI, por cliente/banco) — SECRETO
clientes/*/.credenciales/
**/credenciales.dat
**/*.key
**/*.pem

# Runtime por cliente/banco (perfil del navegador, capturas, estado, logs,
# descargas temporales) — datos de la maquina, se regeneran solos
clientes/*/.run/
**/perfil_navegador/
**/capturas/
**/descargas_temp/
**/estado_descargas.json
**/log.txt

# Python
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node / clasp (si se versionan Apps Script mas adelante)
node_modules/

# Sistema
Thumbs.db
desktop.ini
.DS_Store
clientes/*/memoria/
salidas/

# Los informes generados llevan datos reales del cliente: se regeneran con
# dashboard/generar.py y no se versionan.
salidas/*.html

# Planillas y diagnosticos con datos reales del cliente. Un repo cambia de
# privado a publico con dos clicks; una planilla de un tercero no se despublica.
clientes/*/privado/
clientes/*/*.xlsx
clientes/*/*.xls
clientes/*/*.csv
clientes/*/contrato_*.json
datos/*.xlsx
datos/*.xls

# Carpeta de sincronizacion de Cowork y archivos que caen en la raiz al enviar/recibir
Claude outputs/
/*.xlsx
/*.xls
